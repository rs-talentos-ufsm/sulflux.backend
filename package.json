{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format esm --clean --tsconfig tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "nodemon --config nodemon.json",
    "db-migrate-dev": "dotenv -e .env.development -- prisma migrate dev",
    "db-studio-dev": "dotenv -e .env.development -- prisma studio",
    "format-check": "prettier --check .",
    "format-fix": "prettier --write .",
    "lint-check": "eslint .",
    "lint-fix": "eslint . --fix",
    "prepare": "husky",
    "dev-upd": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development up --build -d",
    "dev-up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development up",
    "dev-down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development down",
    "dev-reset": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development down -v",
    "test-db-up": "docker compose -f docker-compose.test.yml --env-file .env.test up -d --wait db_test",
    "test-db-down": "docker compose -f docker-compose.test.yml --env-file .env.test down -v",
    "prisma:test": "dotenv -e .env.test -- npx prisma db push --accept-data-loss",
    "test": "npm run test-db-up && vitest run --mode test && npm run test-db-down",
    "test-watch": "vitest --mode test",
    "test-coverage": "vitest run --coverage --mode test",
    "prod-up": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production up --build -d",
    "prod-down": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production down",
    "prod-reset": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production down -v",
    "log": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development logs -f",
    "log-prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production logs -f",
    "seed": "ts-node prisma/seed.ts",
    "prisma-generate": "dotenv -e .env.development -- prisma generate",
    "docker-generate": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development exec backend npx prisma generate",
    "docker-migrate": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development exec backend npx prisma migrate dev",
    "docker-migrate-create-only": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development exec backend npx prisma migrate dev --create-only",
    "docker-migrate-reset": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file ./.env.development exec backend npx prisma migrate reset --force",
    "prisma-generate-prod": "dotenv -e .env.production -- prisma generate",
    "docker-generate-prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production exec backend npx prisma generate",
    "docker-migrate-prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file ./.env.production exec backend npx prisma migrate deploy"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@lib/shared": "git+https://github.com/dorneles-laboratory/pgi-proa.shared.git#main",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/instrumentation": "^7.8.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@prisma/config": "^7.8.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.18",
    "depcheck": "^1.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vitest": "0.5.4",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prisma": "7.8.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@typescript-eslint/utils": "^8.59.2",
    "lodash": "^4.17.21",
    "hono": "^4.12.18",
    "effect": "^3.20.0",
    "@hono/node-server": "1.19.13",
    "zod": "$zod",
    "@asteasolutions/zod-to-openapi": {
      "zod": "$zod"
    }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts --force"
  }
}
