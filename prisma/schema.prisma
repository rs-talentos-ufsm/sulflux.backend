generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
}


enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum TimeLogNature {
  DEV
  MEETING
  TESTING
  DOCUMENTATION
  CODE_REVIEW
  OTHER
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}


model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  password      String
  is_active     Boolean   @default(true)

  refreshTokens RefreshToken[]

  ownedProjects      Project[]
  projectMemberships ProjectMember[]
  ownedTasks         Task[]
  taskMemberships    TaskMember[]
  timeSessions       TimeSession[]
  timeLogs           TimeLog[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users") // tabela no banco chama 'users'
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique // O hash do token
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id])
  members   ProjectMember[]

  tasks     Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // Impede que o mesmo usuário seja adicionado duas vezes no mesmo projeto
  @@map("project_members")
}

model Task {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  description String?        @db.Text
  dueDate     DateTime?      @map("due_date")
  priority    TaskPriority   @default(LOW)
  status      TaskStatus     @default(BACKLOG)
  
  projectId   String         @map("project_id") @db.Uuid
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  totalMinutes Int           @default(0)
  timeSessions TimeSession[]
  timeLogs     TimeLog[]

  ownerId     String?         @map("owner_id") @db.Uuid
  owner       User?           @relation(fields: [ownerId], references: [id])
  members     TaskMember[]

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("tasks")
}

model TaskMember {
  id        String      @id @default(uuid()) @db.Uuid
  taskId    String      @map("task_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  
  role      TaskRole    @default(MEMBER)
  joinedAt  DateTime    @default(now()) @map("joined_at")

  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_members")
}

model TimeSession {
  id             String    @id @default(uuid()) @db.Uuid
  taskId         String    @map("task_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  
  startTime      DateTime  @map("start_time")
  endTime        DateTime? @map("end_time") 
  isConsolidated Boolean   @default(false) @map("is_consolidated") 

  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("time_sessions")
}

model TimeLog {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  
  date           DateTime 
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  loggedMinutes  Int    @map("logged_minutes") @default(0)
  
  nature         TimeLogNature
  description    String   @db.Text
  
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("time_logs")
}