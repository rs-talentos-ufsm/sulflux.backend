generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ==================================
//              ENUMS
// ==================================

enum PropertyStatus {
  ACTIVE
  CONFIGURE
}

enum FieldStatus {
  READY
  PROCESSING
  WAITING
}

// ==================================
//             SCHEMAS
// ==================================

model User {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  email         String      @unique
  password      String
  isActive      Boolean     @default(true) @map("is_active")

  refreshTokens             RefreshToken[]
  ownedProperties           Property[]
  
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("users") // tabela no banco chama 'users'
}

model RefreshToken {
  id        String          @id @default(uuid()) @db.Uuid
  token     String          @unique
  userId    String          @db.Uuid @map("user_id")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime 
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Property {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  location  String
  car       String?        @unique
  status    PropertyStatus @default(CONFIGURE)

  ownerId   String         @db.Uuid @map("owner_id")
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  fields    Field[]
  
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("properties")
}

model Field {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  code        String
  soilType    String?     @map("soil_type")
  area        Float?
  perimeter   Float?
  coordinates Json?       // Armazena Lat/lng do polígono
  status      FieldStatus @default(WAITING)
  
  propertyId  String      @db.Uuid @map("property_id")
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([propertyId])
  @@map("fields")
}